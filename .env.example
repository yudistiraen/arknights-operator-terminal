# Required to let Vercel Cron call /api/cron/scrape-events — pick any random
# string and set the same value as an env var on the Vercel project.
CRON_SECRET=

# GitHub Personal Access Token (fine-grained, "Contents: Read and write" on
# this repo only) used by the cron job to commit regenerated
# src/data/events.ts + new banner images so Vercel picks them up via a normal
# deploy.
EVENTS_SYNC_GITHUB_TOKEN=

# Optional — default to this repo, override only if you fork/rename it.
EVENTS_SYNC_GITHUB_OWNER=yudistiraen
EVENTS_SYNC_GITHUB_REPO=arknights-operator-terminal
EVENTS_SYNC_TARGET_BRANCH=main

# Cloudflare R2 asset bucket (scripts/assets/sync-r2.sh, knowledge/cloudflare_r2.md).
# Create an R2 API token with "Object Read & Write" scoped to the bucket.
# Put real values in .env (gitignored), never commit them. Local only, not needed on Vercel.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arknights-portfolio-assets

# Public URL of the R2 bucket (src/lib/assetUrl.ts). Leave empty locally so dev serves public/;
# set it on the Vercel project (Production + Preview) once the bucket has a custom domain,
# e.g. https://assets.<domain>. Must stay UNSET on Vercel while the R2_PUBLIC_URL proxy below is in use.
NEXT_PUBLIC_ASSET_URL=

# Temporary proxy target (next.config.ts rewrites) while r2.dev is blocked by Indonesian ISPs.
# Set on Vercel only (Config, Production + Preview), e.g. https://pub-xxxx.r2.dev — knowledge/cloudflare_r2.md §0.
R2_PUBLIC_URL=
